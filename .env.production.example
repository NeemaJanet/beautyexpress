# =============================================================================
# BeautyExpress — FRONTEND environment variables for PRODUCTION
#
# Do not create a .env.production file in the repository. Enter these values
# in Vercel: Project > Settings > Environment Variables (Production).
# =============================================================================
VITE_APP_NAME=BeautyExpress
VITE_SUPPORT_EMAIL=support@yourdomain.ca
VITE_LEGAL_NAME=Your Registered Business Name Inc.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Use pk_test_ until you have completed the "Going live" checklist in DEPLOYMENT.md
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

VITE_MAPS_PROVIDER=mapbox
VITE_MAPBOX_TOKEN=pk.your-url-restricted-token
VITE_GOOGLE_MAPS_KEY=
