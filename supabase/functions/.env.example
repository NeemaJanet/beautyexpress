# =============================================================================
# BeautyExpress — SERVER secrets for Supabase Edge Functions
#
# Local:      copy to supabase/functions/.env  (git-ignored), then
#             supabase functions serve --env-file supabase/functions/.env
# Production: supabase secrets set --env-file ./my-prod-secrets.env
#             (or Dashboard > Edge Functions > Secrets)
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by Supabase to deployed functions — do not set them yourself.
# =============================================================================

# Your website address (used for Stripe onboarding return links, email links and CORS)
APP_URL=http://localhost:5173
APP_NAME=BeautyExpress
# Comma-separated extra allowed origins (optional)
ALLOWED_ORIGINS=http://localhost:5173

# Stripe (test mode first: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Signing secret of a second endpoint listening to "connected accounts" events (optional)
STRIPE_CONNECT_WEBHOOK_SECRET=

# Shared secret for scheduled jobs (generate with: openssl rand -hex 32)
CRON_SECRET=replace-with-a-long-random-string

# Email via Resend (optional; without it, email notifications are skipped)
RESEND_API_KEY=
EMAIL_FROM=BeautyExpress <notifications@yourdomain.ca>

# SMS via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
