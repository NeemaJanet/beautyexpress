# Database connection for the setup scripts (npm run db:setup / db:seed / db:check).
# 1. Copy this file to .env.database   (copy .env.database.example .env.database)
# 2. Supabase dashboard > click "Connect" (top of the page) > "Session pooler"
#    Copy the URI and replace [YOUR-PASSWORD] with your database password.
# This file is NOT used by the website and must never be committed or shared.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
