# =============================================================================
# BeautyExpress — FRONTEND environment variables (development)
#
# 1. Copy this file to a new file named  .env  (same folder).
# 2. Fill in the values. NEVER commit .env (it is in .gitignore).
#
# Everything starting with VITE_ is bundled into the website and visible to
# anyone. Only PUBLIC keys belong here. Secret keys (Stripe secret key,
# Supabase service-role key, email/SMS keys) go into Supabase Edge Function
# secrets instead — see supabase/functions/.env.example and DEPLOYMENT.md.
# =============================================================================

# Branding (optional)
VITE_APP_NAME=BeautyExpress
VITE_SUPPORT_EMAIL=support@example.com
VITE_LEGAL_NAME=Your Business Name Inc.

# Supabase: Dashboard > Project Settings > API
# Local development with `supabase start`: use the URL and anon key it prints.
VITE_SUPABASE_URL=https://mqfksvfkcrcqzcgqxeya.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1xZmtzdmZrY3JjcXpjZ3F4ZXlhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMxMjc0MjYsImV4cCI6MjEwODcwMzQyNn0._rVGXsqE74G_i4-DggQWVYcPGazlHl8snlFBvcRkTzk

# Stripe PUBLISHABLE key (starts with pk_test_ in test mode). Optional until
# you turn on online payments in Admin > Platform settings.
VITE_STRIPE_PUBLISHABLE_KEY=

# Maps / address lookup (optional). Leave empty to use the built-in city list.
# mapbox: public token restricted to your domain
# google: browser key restricted by HTTP referrer, with Geocoding API enabled
VITE_MAPS_PROVIDER=
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_KEY=
